{
  "manifest_version": 3,
  "name": "Susanin Helper",
  "description": "Текущий сайт в списки Susanin.Keenetic: vpn_always (всегда в туннеле) / vpn_never (всегда напрямую), через веб-панель",
  "version": "0.2",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://192.168.*/*",
    "http://10.*/*",
    "http://172.16.*/*",
    "http://172.17.*/*",
    "http://172.18.*/*",
    "http://172.19.*/*",
    "http://172.20.*/*",
    "http://172.21.*/*",
    "http://172.22.*/*",
    "http://172.23.*/*",
    "http://172.24.*/*",
    "http://172.25.*/*",
    "http://172.26.*/*",
    "http://172.27.*/*",
    "http://172.28.*/*",
    "http://172.29.*/*",
    "http://172.30.*/*",
    "http://172.31.*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Susanin Helper: списки always/never" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
