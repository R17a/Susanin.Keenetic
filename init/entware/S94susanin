#!/bin/sh
# Entware init script for susanin-agent (Keenetic/Entware).
# Uses the project's own control script (susanin.sh) instead of Entware rc.func,
# whose path (/etc/init.d/rc.func) may not exist on KeeneticOS.
# Install as /opt/etc/init.d/S94susanin and make executable.
# Test: /opt/etc/init.d/S94susanin start|stop|restart|status

SUSANIN_SH=/opt/susanin/tools/susanin.sh

start() {
    [ -x /opt/susanin/bin/susanin-agent ] || return 1
    mkdir -p /opt/susanin/var
    sh "$SUSANIN_SH" start
    # Статические профили (P1): no-op, если профили не заданы.
    [ -x /opt/susanin/tools/profiles.sh ] && sh /opt/susanin/tools/profiles.sh up >/dev/null 2>&1 || true
}

stop() {
    sh "$SUSANIN_SH" stop
}

# status — есть в susanin.sh; раньше ветки не было, и report.sh (он вызывает
# S94susanin status) получал «Usage: … {start|stop|restart}» вместо состояния.
status() {
    sh "$SUSANIN_SH" status
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
