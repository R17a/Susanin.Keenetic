#!/bin/sh /etc/rc.common
# OpenWRT procd service for susanin-agent.
#
# Install as /etc/init.d/susanin (chmod +x), then:
#   /etc/init.d/susanin enable
#   /etc/init.d/susanin start
#
# Directory layout (platform=openwrt, see src/platform.c):
#   bin   /usr/bin
#   etc   /etc/susanin
#   var   /var/lib/susanin
#   tools /usr/lib/susanin

START=95
STOP=10
USE_PROCD=1

SUSANIN_BINDIR=/usr/bin
SUSANIN_ETCDIR=/etc/susanin
SUSANIN_VARDIR=/var/lib/susanin
SUSANIN_TOOLSDIR=/usr/lib/susanin

start_service() {
    if [ ! -x "$SUSANIN_BINDIR/susanin-agent" ]; then
        echo "susanin-agent not found: $SUSANIN_BINDIR/susanin-agent" >&2
        return 1
    fi
    mkdir -p "$SUSANIN_VARDIR"

    procd_open_instance
    procd_set_param command "$SUSANIN_BINDIR/susanin-agent" run
    procd_set_param env \
        SUSANIN_PLATFORM=openwrt \
        SUSANIN_CONF="$SUSANIN_ETCDIR/susanin.conf" \
        SUSANIN_LOG="$SUSANIN_VARDIR/susanin.log" \
        SUSANIN_BINDIR="$SUSANIN_BINDIR" \
        SUSANIN_ETCDIR="$SUSANIN_ETCDIR" \
        SUSANIN_VARDIR="$SUSANIN_VARDIR" \
        SUSANIN_TOOLSDIR="$SUSANIN_TOOLSDIR"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
