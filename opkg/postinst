#!/bin/sh
# postinst — после установки/обновления пакета susanin-keenetic (.ipk).
# Правила: данные пользователя (конфиг, списки, состояние, профили) НЕ перезаписываем.
set -u
PREFIX=/opt/susanin

mkdir -p "$PREFIX/var" "$PREFIX/var/backup" "$PREFIX/etc/profiles"
chmod 755 "$PREFIX" 2>/dev/null || true
chmod +x "$PREFIX/tools/"*.sh 2>/dev/null || true
chmod +x "$PREFIX/bin/susanin-agent" 2>/dev/null || true

# Конфиг: только если его ещё нет.
if [ ! -f "$PREFIX/etc/susanin.conf" ] && [ -f "$PREFIX/share/susanin.conf.example" ]; then
    cp "$PREFIX/share/susanin.conf.example" "$PREFIX/etc/susanin.conf"
    echo "[susanin] создан конфиг $PREFIX/etc/susanin.conf (проверьте egress_interface/lan_interfaces)"
fi

# Списки: только если их ещё нет (пользовательские правки не трогаем).
for _l in vpn_always vpn_never; do
    if [ ! -f "$PREFIX/etc/$_l.txt" ]; then
        if [ -f "$PREFIX/share/$_l.txt" ]; then
            cp "$PREFIX/share/$_l.txt" "$PREFIX/etc/$_l.txt"
        else
            : > "$PREFIX/etc/$_l.txt"
        fi
    fi
done

# --- merge списков при обновлении ------------------------------------------
# Раньше список только копировался, если файла не было, поэтому новые домены из
# сборки (например, Telegram) до установленных систем не доезжали. Теперь
# дописываем ТОЛЬКО отсутствующие строки: порядок и правки пользователя целы,
# комментарии из пакета не переносим, перед изменением — один бэкап `.bak`.
merge_list() { # merge_list <файл пользователя> <файл пакета> <метка>
    _u="$1"; _p="$2"; _lbl="$3"
    [ -f "$_u" ] && [ -f "$_p" ] || return 0
    _tmp="$_u.merge.$$"
    cp "$_u" "$_tmp" 2>/dev/null || return 0
    _added=0
    _hdr=0
    while IFS= read -r _line; do
        case "$_line" in ''|'#'*) continue ;; esac
        grep -qxF "$_line" "$_tmp" 2>/dev/null && continue
        if [ "$_hdr" -eq 0 ]; then
            printf '\n# === добавлено при обновлении пакета (%s) ===\n' "$_lbl" >> "$_tmp"
            _hdr=1
        fi
        printf '%s\n' "$_line" >> "$_tmp"
        _added=$((_added + 1))
    done < "$_p"
    if [ "$_added" -gt 0 ]; then
        cp -f "$_u" "$_u.bak" 2>/dev/null || true
        mv -f "$_tmp" "$_u"
        echo "[susanin] $_lbl: +$_added записей (merge), бэкап $_lbl.txt.bak"
    else
        rm -f "$_tmp"
    fi
}
merge_list "$PREFIX/etc/vpn_always.txt" "$PREFIX/share/vpn_always.txt" vpn_always
merge_list "$PREFIX/etc/vpn_never.txt" "$PREFIX/share/vpn_never.txt" vpn_never
rm -f "$PREFIX/etc/vpn_always.txt".merge.* "$PREFIX/etc/vpn_never.txt".merge.* 2>/dev/null || true

# --- миграция значений по умолчанию ----------------------------------------
# promo_per_min: в 0.4.0 дефолт поднят 30 -> 120 (обучение быстрее).
# Меняем ТОЛЬКО если стоит прежний дефолт — своё значение пользователя не трогаем.
if [ -f "$PREFIX/etc/susanin.conf" ]; then
    _pp=$(sed -n 's/^promo_per_min=//p' "$PREFIX/etc/susanin.conf" 2>/dev/null | tail -n1)
    if [ "$_pp" = "30" ]; then
        sed -i 's/^promo_per_min=.*/promo_per_min=120/' "$PREFIX/etc/susanin.conf" 2>/dev/null \
            && echo "[susanin] promo_per_min: 30 -> 120 (новый дефолт; применится после restart)"
    fi
fi

# Короткий вызов `susanin …` (чужой файл с этим именем не перезаписываем).
if [ -d /opt/bin ] && [ ! -e /opt/bin/susanin ]; then
    ln -s "$PREFIX/tools/susanin.sh" /opt/bin/susanin 2>/dev/null || true
fi

# Перезапуск службы (идемпотентно; ошибки не валят установку).
if [ -x /opt/etc/init.d/S94susanin ]; then
    /opt/etc/init.d/S94susanin restart >/dev/null 2>&1 || true
fi
if [ -x /opt/etc/init.d/S95susanin-web ]; then
    if grep -q '^web_enable=1' "$PREFIX/etc/susanin.conf" 2>/dev/null; then
        /opt/etc/init.d/S95susanin-web restart >/dev/null 2>&1 || true
    fi
fi
# Сторож S95xray-guard (был в 0.4.6) из поставки исключён: при обновлении с
# 0.4.6 он мог остаться в /opt/etc/init.d и поднимать Xray против решения
# агента. Снимаем и удаляем остатки (наш pid-файл — тоже наш мусор).
if [ -f /opt/etc/init.d/S95xray-guard ]; then
    /opt/etc/init.d/S95xray-guard stop >/dev/null 2>&1 || true
    rm -f /opt/etc/init.d/S95xray-guard 2>/dev/null || true
    rm -f /opt/var/run/xray-guard.pid 2>/dev/null || true
fi
echo "[susanin] установлено. Проверка: susanin status && susanin diagnose"
exit 0
