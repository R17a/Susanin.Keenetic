[Unit]
Description=Susanin tunnel server (AY)
Documentation=https://github.com/R17a/Susanin.Keenetic
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/susanin-tunnel-server --config=/etc/susanin/tunnel-server.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# TUN + адрес на интерфейсе + UDP/443 требуют прав. CAP_NET_BIND_SERVICE нужен
# именно для порта 443: без него ограничение CapabilityBoundingSet не даёт
# root'у занять привилегированный порт.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Учётные данные и журнал не трогаются: конфиг читается на старте.
LimitNOFILE=65536

# Счётчик пакетов/сессий — в журнале (SIGHUP печатает сводку, SIGUSR1 — список).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tunnel-server

[Install]
WantedBy=multi-user.target
