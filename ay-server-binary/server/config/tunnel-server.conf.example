# tunnel-server — пример конфигурации серверной части туннеля Susanin.
# Формат: key = value, '#' — комментарий. Всё это есть и в ключах --help.
# Рекомендуемое место: /etc/susanin/tunnel-server.conf (права 0640, владелец root).

# --- приём ---------------------------------------------------------------
# UDP-порт. 5004 — значение по умолчанию; подойдёт любой свободный UDP-порт,
# клиент указывает его же (ay_port / host:port).
tunnel_port = 5004
# Адрес привязки. По умолчанию 0.0.0.0 (все интерфейсы).
tunnel_listen = 0.0.0.0

# --- секрет ---------------------------------------------------------------
# Один и тот же PSK должен быть в tunnel_secret на роутере.
# Приоритет: tunnel_secret_file > tunnel_secret.
# Сгенерировать: susanin-tunnel-server --keygen
tunnel_secret =
tunnel_secret_file = /etc/susanin/tunnel.key

# --- туннельный интерфейс --------------------------------------------------
# Сервер сам создаёт интерфейс, поднимает его и вешает адрес/маску/MTU.
tunnel_iface = tun10
tunnel_ip = 10.23.0.1/24
tunnel_net = 10.23.0.0/24
# MTU обязан быть <= 1209 (габарит внутреннего IP-пакета при датаграмме 1280).
tunnel_mtu = 1200

# --- состояние сессий ------------------------------------------------------
# Сессия вычищается, если от клиента нет валидных пакетов дольше этого срока.
tunnel_idle_timeout = 30
tunnel_max_sessions = 256

# --- журнал ---------------------------------------------------------------
# quiet | error | info | debug
tunnel_log_level = info
tunnel_syslog = 1

# --- служебное -------------------------------------------------------------
# TUNSETPERSIST: интерфейс переживает рестарт демона.
tunnel_persist = 1
# Тестовый режим без root и без TUN: принятые IP-пакеты возвращаются отправителю.
tunnel_loopback = 0
