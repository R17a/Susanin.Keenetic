# build intermediates: готовые бинарники агента в репозитории НЕ лежат —
# их собирает локально tools/wsl-build.sh или CI, а .ipk и архив релиза
# собираются из этого файла (make-ipk/stage-release берут его аргументом)
*.o
susanin-agent
/build/
# закрытая часть транспорта AY: кладёт сборщик из проекта Susanin.Keenetic.AY
/src/ay_transport_private.c
# копии кросс-бинарников в корне
/susanin-agent.*
# скомпилированные host-тесты (исходники .c/.sh — на месте)
/tests/test_*
!/tests/test_*.c
# .ipk-пакеты (tools/make-ipk.sh) — артефакты сборки, публикуются в Release
*.ipk
/dist/
/dist-ipk/
# локальные каталоги релизных сборок (dist-v0.4.6, dist-test и т.п.)
/dist-*/

# runtime state / logs (never commit secrets)
*.log
*.state
/opt/

# OpenWRT artifacts (built by CI / tools/build-openwrt.sh; not committed)
# сами бинарники лежат в /build/, он игнорируется целиком выше
/deploy-openwrt/

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# локальные служебные скрипты агентов/разработчика (тестовые обёртки,
# разовые проверки) — внутреннее, на GitHub не публикуется никогда
/local/
