/STATUS.md
/TESTBUILD.md
/docs/RECON.md
/recon/
/AGENTS.md
/readme.html
/release-notes-*.md

# build intermediates (release binaries ARE committed, see build/)
*.o
susanin-agent
# копии кросс-бинарников в корне (build/susanin-agent.* — коммитятся)
/susanin-agent.*
# скомпилированные host-тесты (исходники .c/.sh — на месте)
/tests/test_*
!/tests/test_*.c
# .ipk-пакеты (tools/make-ipk.sh) — артефакты сборки, публикуются в Release
*.ipk
/dist/
/dist-ipk/
# локальные каталоги релизных сборок (dist-v0.4.6, dist-test и т.п.)
/dist-*/

# runtime state / logs (never commit secrets)
*.log
*.state
/opt/

# OpenWRT artifacts (built by CI / tools/build-openwrt.sh; not committed)
/deploy-openwrt/
/build/susanin-agent.openwrt-*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# локальные служебные скрипты агентов/разработчика (тестовые обёртки,
