# Susanin.Keenetic — пример конфигурации (reference).
# Не секретный. Обычно генерируется `susanin setup` / install.sh.
#
# Формат: key=value, по одному на строку; '#' — комментарий.
# ДЛИТЕЛЬНОСТИ пишутся ЧИСЛОМ БЕЗ БУКВ, в единице параметра — она указана
# в его описании (сек / мин / ч). Суффиксы s/m/h/d/w из старых конфигов
# ещё принимаются (напр. cooldown_ttl=5m), но в новом формате — просто число.
#
# Ниже описан каждый параметр.

# --- Egress (VPN/туннель) ---
# Интерфейс(ы) туннеля, через запятую; несколько включают фейловер
# (активен один egress, при падении переключаемся на следующий живой).
egress_interface=nwg0
# Адрес(а) туннеля — по индексу с интерфейсами (по адресу берётся source
# для health-проб каждого egress). Один адрес допускается на все интерфейсы.
#   egress_address=10.8.1.1,10.8.1.2
egress_address=10.8.1.1

# --- LAN (ingress) ---
# LAN-интерфейсы, через запятую.
lan_interfaces=br0,br1
# LAN-подсети (CIDR), через запятую.
lan_subnets=192.168.1.0/24,10.1.30.0/24

# --- Маршрутизация / метки (fwmark, hex, 32 бита) ---
# Номер таблицы маршрутизации для VPN (небольшой — ограничение busybox ip).
routing_table=100
# fwmark «test»-фазы.
mark_test=0x10000000
# fwmark «ok»-фазы — подтверждено, идёт через VPN.
mark_ok=0x20000000
# Маска fwmark для правил.
mark_mask=0x30000000
# Стартовый приоритет ip rule.
ip_rule_priority_start=2000

# --- Таймеры детекта/обучения (сек) ---
# Интервал «быстрой» фазы детекта, сек.
fast_interval=1
# Интервал «мягкой» фазы детекта (потоки с ответами, которые тормозят), сек.
soft_interval=1
# Интервал фазы подтверждения (judge), сек.
judge_interval=1
# Интервал health-проб туннеля, сек.
health_interval=5
# «Быстрый» детект: сколько SYN без ответа нужно для реакции
# (1 = быстрее, больше ложных срабатываний).
fast_syn_min_op=2
# Порты, для которых отключено БЫСТРОЕ автообучение (типовой скан-шум),
# через запятую. «Мягкое» обучение и веб (80/443/QUIC) продолжают работать.
learn_exclude_ports=22,23,53,135,137,138,139,445,500,554,853,1433,1723,3306,3389,4500,5432,5900,6379,7547,8567,9100,11211,27017
# Интерфейсы, которые НИКОГДА не берём как egress/LAN, через запятую
# (соседство с серверными туннелями qWDTT: wdtt0/wdttraw0 и т.п.).
discover_exclude=wdtt0,wdttraw0,tun0,tap0
# Туннели-СЕРВЕРЫ, чьих клиентов тоже обрабатываем как LAN, через запятую.
lan_server_interfaces=

# --- Кэш ok / test / cooldown ---
# TTL выученных ok-адресов, сек; 0 = никогда не истекает (наборы растут,
# адреса «залипают» в VPN — рекомендуется конечный TTL).
ok_ttl=21600
# Обновлять ok-адрес, если до истечения меньше заданного, ч.
ok_refresh_below=3
# Лимит записей ok-кэша на протокол; 0 = без лимита (bounded GC).
ok_max_entries=4096
# Гистерезис снятия из ok: сколько ПОДРЯД «сбоев» по адресу нужно (1 = сразу).
ok_evict_misses=3
# Лимит новых переводов в VPN в минуту; 0 = без лимита.
promo_per_min=30
# TTL «test»-состояния (проба через VPN), мин.
test_ttl=1
# «Остывание» после снятия адреса из ok, мин.
cooldown_ttl=5
# «Остывание» успешно подтверждённого адреса, сек.
cooldown_ok_ttl=30
# TTL «наблюдения» за подозрительным потоком, сек.
watch_ttl=8
# Мин. время до повторной пробы «наблюдения», сек.
watch_retry_below=4

# --- Health-проверка туннеля ---
# Адреса health-проб через туннель, через запятую.
health_probe=1.1.1.1,8.8.8.8
# Порог «туннель упал»: подряд неудачных проб (5s x 4 = 20s).
health_miss_debounce=4
# Тип пробы: icmp (по умолчанию) | tcp. Для egress, который не несёт ICMP
# (VLESS/XRay через TUN), укажите tcp — иначе туннель будет считаться «мёртвым».
health_mode=icmp
# Порт TCP-пробы (для health_mode=tcp).
health_tcp_port=443

# --- Списки «всегда через VPN» / «всегда напрямую» ---
# Файл списка «всегда через VPN» (по строке на домен/IP/CIDR).
vpn_always_file=/opt/susanin/etc/vpn_always.txt
# Резолвер для списков; пусто = авто (роутер / LAN-мост).
vpn_always_dns=
# Период обновления списка «всегда через VPN», сек.
vpn_always_interval=300
# Файл списка «всегда напрямую».
vpn_never_file=/opt/susanin/etc/vpn_never.txt
# Период обновления списка «всегда напрямую», сек.
vpn_never_interval=300

# --- Логи и режим носителя ---
# Уровень логов агента Susanin.Keenetic: quiet | error | warn | info | debug | trace.
log_level=info
# Уровень логов Xray (ОТДЕЛЬНО от log_level агента): debug | info | warning | none.
# Читается xray-egress.sh / S93xray-tproxy, самим агентом не разбирается.
xray_loglevel=warning
# Режим носителя: normal (лог/бэкапы) | soft (минимум записей на NAND/flash).
disk_mode=normal
# Период сохранения состояния в soft-режиме, ч; 0 = никогда.
soft_state_interval=12

# --- Встроенная веб-панель ---
# Включена: 0 | 1 (запуск: `susanin-agent web`).
web_enable=0
# Адрес (только LAN, не 0.0.0.0).
web_listen=192.168.1.1
# Порт.
web_port=8087
# Токен доступа; пусто = вход без пароля (не рекомендуется).
web_token=

# --- Egress через XRay (tproxy) ---
# Тип egress: interface (nwg*/wdtt*/tun*) | tproxy (XRay/REALITY без TUN).
egress_type=interface
# Порт локального Xray (dokodemo-door redirect) для egress_type=tproxy.
tproxy_port=12345
# UDP-релей (нужен только при egress_type=tproxy): 0 | 1.
udp_relay=0
# Порт приёма UDP-релея (TPROXY).
udp_relay_port=1081
# Адрес Xray SOCKS (для UDP-релея).
socks_addr=127.0.0.1
# Порт Xray SOCKS.
socks_port=1080

# --- Профили маршрутизации (до 4; включается заданием profileN_name) ---
# Профиль направляет свой список на отдельный туннель со своей таблицей/mark.
#   profileN_name=имя        (включает профиль; [a-z0-9_])
#   profileN_egress=nwg1     (интерфейс туннеля)
#   profileN_list=/opt/susanin/etc/profiles/имя.txt
#   profileN_table=201       (по умолчанию 201..204)
#   profileN_mark=0x40000000 (по умолчанию 0x40000000/0x08000000/0x04000000/0x02000000)
# Управление: sh /opt/susanin/tools/profiles.sh {up|down|status}
# Профилей нет, пока не задан ни один profileN_name.

# --- Сверка датаплейна (reconcile) ---
# Период сверки, сек; 0 = 15. Меньше — быстрее вернём правила, снесённые NDM.
dp_check_interval=15

# --- Автообучение: пороги (L1–L6) ---
# L1: мин. пакетов к адресу для обучения.
learn_min_op=10
# L2: мин. байт «от нас» для обучения.
learn_min_bytes=2000
# L4: мин. ответных байт для подтверждения (judge).
confirm_min_bytes=512
# Удвоить пороги обучения (ещё строже): 0 | 1.
learn_strict=0

# --- CDN-универсал (агрегация по префиксу) ---
# Файл диапазонов CDN (по одной сети в строке).
cdn_ranges_file=/opt/susanin/etc/cdn_ranges.txt
# URL источника диапазонов (wget/curl, раз в сутки).
cdn_ranges_url=https://www.cloudflare.com/ips-v4
# Период обновления, сек; 0 = не обновлять автоматически.
cdn_ranges_interval=86400
# Агрегация подтверждённого CDN-адреса по префиксу: 0 | 1.
cdn_prefix_learn=1
# TTL агрегированного CDN-префикса, сек.
cdn_prefix_ttl=3600
# Не агрегировать шире этой маски (число бит; /24 ограничивает «радиус»).
cdn_prefix_max=24
# Сколько РАЗНЫХ адресов подтвердить до агрегации префикса (>=1; 1 = по первому).
aggregate_confirm=2

# --- Политики IPv6 / QUIC ---
# Блокировать IPv6 из LAN (клиенты уходят на IPv4): 0 | 1.
ipv6_block=1
# Блокировать QUIC (UDP/443) из LAN: 0 | 1.
quic_block=1

# --- Egress master/slave (failback) ---
# 1 = вернуться на приоритетный VPN после восстановления (Master/Slave).
egress_failback=1
# Сколько секунд Master должен держать UP до возврата (антидребезг), сек.
egress_failback_debounce=30
# N3: race-пробинг egress — выбрать быстрейший по замеру: 0 | 1.
# Кандидаты — все интерфейсы из egress_interface (через запятую).
egress_race=0

# --- Xray: память и watchdog ---
# GOGC Xray (меньше = агрессивнее GC).
xray_gogc=50
# GOMEMLIMIT Xray (мягкий лимит памяти, напр. 64MiB).
xray_gomemlimit=64MiB
# 1 = агент сам поднимает упавший Xray (tproxy) с backoff.
xray_watchdog=1

# --- N2: kernel-offload (ok_net через интерфейс, мимо userspace tproxy) ---
kernel_offload=0
kernel_egress=
kernel_offload_max=24

# --- DNS-снифинг (домен->IP, зеркально; штатный DNS не трогаем) ---
dns_sniff=0
# TTL записи домен->IP, сек.
dns_sniff_ttl=300
# Интерфейс захвата; пусто = первый lan_interface.
dns_sniff_iface=
# P1: периодически передобавлять пины списков (самолечение): 0 | 1.
pin_reassert=1

# --- D1: мягкое «прямо» (авто-возврат «в VPN хуже -> прямо») ---
# 1 = если адрес в VPN деградирует, временно принудительно направить его прямо.
auto_direct=1
# TTL мягкого «прямо», сек.
direct_pref_ttl=3600

# --- M1: класс media (IPTV/видео) ---
# 1 = детект по форме потока и агрегация префикса в VPN (последующие потоки
# идут через VPN с первого пакета, без FASTNAT-залипаний). По умолчанию 0.
media_enabled=0
media_ports=80,443,554,1935,8080,8443
media_min_bytes=1048576
media_ratio=8
media_min_rate=150000
media_min_age=12
media_ttl=21600
media_prefix_max=24

# --- MSS/PMTU (для туннеля/CDN: второй туннель может фрагментироваться) ---
# MSS для VPN-потоков: 0 = выкл, число байт (напр. 1380) или pmtu.
mss_clamp=0
# 1 = применять MSS ко всему LAN-forward, 0 = только к нашим VPN-потокам.
mss_clamp_lan=0

# --- Профили маршрутизации (P2) ---
# Движок поддерживает default в table профиля на первом живом egress: 0 | 1.
profile_failover=1
# Профиль задаётся ключами profileN_* (name/egress/list/geo_url/table/mark/auto)
# или файлом /opt/susanin/etc/profiles.d/<name>.conf с теми же полями.
# profile1_name=cdn
# profile1_egress=nwg0,nwg1
# profile1_list=/opt/susanin/etc/profiles/cdn.txt
# profile1_geo_url=
# profile1_table=201
# profile1_mark=0x40000000
# profile1_auto=1        # авто-пин подтверждённых IP, попадающих в диапазон профиля
